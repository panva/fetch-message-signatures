{
  "extends": "./tsconfig.json",
  "include": ["./test/**/*.ts"],
  "compilerOptions": {
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": false,
    "types": ["node"],
    "resolveJsonModule": true,
    "isolatedDeclarations": false
  }
}
